# Chess Teacher Configuration
# Copy to .env.chess and uncomment the appropriate section.
#
# We use .env.chess (not .env) to avoid conflicts with ChromaDB's
# pydantic-settings, which reads .env and rejects unknown fields.
#
# The built-in local engine-backed player is the instant no-login default. Hosted providers are optional.

# -----------------------------------------------------------
# GPU host (local Ollama)
# -----------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:14b
# EMBED_MODEL=nomic-embed-text
# STOCKFISH_HASH_MB=256

# -----------------------------------------------------------
# VPS (OpenRouter + remote embeddings)
# -----------------------------------------------------------
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
# LLM_API_KEY=sk-or-...
# EMBED_BASE_URL=https://api.together.xyz
# EMBED_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
# EMBED_API_KEY=...
# STOCKFISH_HASH_MB=64

# -----------------------------------------------------------
# Free hosted AI providers
# -----------------------------------------------------------
# OpenCode Big Pickle free trial (currently keyless; availability is limited
# and temporary, so do not send sensitive data):
# LLM_PROVIDER=opencode-free
# LLM_BASE_URL=https://opencode.ai/zen
# LLM_MODEL=big-pickle
# LLM_API_KEY=
#
# Google AI Studio free tier:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...              # Create at https://aistudio.google.com/apikey
#
# Groq free developer tier:
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=...              # Create at https://console.groq.com/keys
#
# OpenRouter free models (about 50 requests/day without purchased credits):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_MODEL=openrouter/free
# LLM_API_KEY=...
#
# -----------------------------------------------------------
# All available settings (with defaults)
# -----------------------------------------------------------
# LLM_PROVIDER=local         # local, ollama, openrouter, openai, deepseek, codex, ...
# LLM_BASE_URL=              # empty for the built-in local AI
# LLM_MODEL=stockfish-local-v1  # local Stockfish-backed player
# LLM_API_KEY=               # Optional. Bearer token for auth
# LLM_TIMEOUT=30.0           # LLM request timeout in seconds
# LLM_EFFORT=auto            # auto, low, medium, high, or provider-supported level
#
# EMBED_BASE_URL=            # Defaults to LLM_BASE_URL
# EMBED_MODEL=nomic-embed-text
# EMBED_API_KEY=             # Defaults to LLM_API_KEY
#
# STOCKFISH_PATH=stockfish   # Path to Stockfish binary
# STOCKFISH_HASH_MB=64       # Stockfish hash table size in MB
#
# CHROMADB_DIR=data/chromadb # ChromaDB persistence directory
# PUZZLE_DB_PATH=data/puzzles.db
# RAG_TOP_K=3                # Number of knowledge chunks to retrieve (0 = disabled)
# AUTO_INIT_PUZZLES=true     # Download puzzles from Lichess on first boot
#
# LISTEN_ADDR=127.0.0.1     # Docker compose: bind address
# PORT=8000                  # Docker compose: host port
